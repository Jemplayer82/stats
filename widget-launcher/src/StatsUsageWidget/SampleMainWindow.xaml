<Window x:Class="StatsUsageWidget.SampleMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Usage Widget Preview"
        Width="780" Height="520"
        MinWidth="720" MinHeight="460"
        Background="#FF0B1018"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="WidgetContainer" Grid.Column="0" />
        <Border x:Name="SettingsContainer" Grid.Column="2"
                Background="#FF151C28" CornerRadius="16" Padding="18" />
    </Grid>
</Window>
