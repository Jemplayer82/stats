<UserControl x:Class="StatsUsageWidget.Widgets.SystemMonitor.Views.SettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340" Height="210">
    <StackPanel Margin="18">
        <TextBlock Text="System Monitor Settings" Foreground="White" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Resize the complete five-gauge cluster together."
                   Foreground="#FFB7C2D0" FontSize="12" Margin="0,6,0,18" />

        <DockPanel LastChildFill="False">
            <TextBlock Text="Cluster size" Foreground="White" FontSize="13" />
            <TextBlock Text="{Binding TempScalePercent, StringFormat={}{0}%}"
                       Foreground="#FF7DD3FC" FontSize="13" FontWeight="SemiBold"
                       DockPanel.Dock="Right" />
        </DockPanel>

        <Slider Minimum="50" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True"
                Value="{Binding TempScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,10,0,2" />

        <DockPanel LastChildFill="False">
            <TextBlock Text="50%" Foreground="#FF7F8B99" FontSize="11" />
            <TextBlock Text="125%" Foreground="#FF7F8B99" FontSize="11" DockPanel.Dock="Right" />
        </DockPanel>

        <TextBlock Text="Apply the setting from the widget settings window."
                   Foreground="#FF7F8B99" FontSize="11" Margin="0,18,0,0" />
    </StackPanel>
</UserControl>
