<UserControl x:Class="StatsUsageWidget.Widgets.SystemMonitor.Views.MainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StatsUsageWidget.Widgets.SystemMonitor.Views"
             Width="390" Height="390">
    <Border BorderBrush="#FF27313A" BorderThickness="1" CornerRadius="18" Padding="8">
        <Border.Background>
            <SolidColorBrush Color="#FF0B0E12" Opacity="0.98" />
        </Border.Background>
        <Canvas Width="372" Height="372" ClipToBounds="False">
            <TextBlock Canvas.Left="12" Canvas.Top="5" Text="SYSTEM MONITOR"
                       Foreground="#FFB8C0C7" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Canvas.Right="12" Canvas.Top="5" Text="{Binding StatusText}"
                       Foreground="#FF64717A" FontSize="9" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="14" Canvas.Top="31"
                             Progress="{Binding MemoryPercent}"
                             Accent="#FF4EA1FF"
                             Label="RAM"
                             ValueText="{Binding MemoryText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="246" Canvas.Top="31"
                             Progress="{Binding NetworkDialPercent}"
                             Accent="#FFB28CFF"
                             Label="NETWORK"
                             ValueText="{Binding NetworkText}" />

            <local:DialGauge Width="170" Height="170"
                             Canvas.Left="101" Canvas.Top="101"
                             Progress="{Binding CpuPercent}"
                             Accent="#FF4FE08B"
                             Label="CPU"
                             ValueText="{Binding CpuText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="14" Canvas.Top="246"
                             Progress="{Binding DiskReadDialPercent}"
                             Accent="#FFFFBE55"
                             Label="DISK READ"
                             ValueText="{Binding DiskReadText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="246" Canvas.Top="246"
                             Progress="{Binding DiskWriteDialPercent}"
                             Accent="#FFFF7D4D"
                             Label="DISK WRITE"
                             ValueText="{Binding DiskWriteText}" />
        </Canvas>
    </Border>
</UserControl>
