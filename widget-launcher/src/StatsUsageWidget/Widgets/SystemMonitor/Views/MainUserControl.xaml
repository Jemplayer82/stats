<UserControl x:Class="StatsUsageWidget.Widgets.SystemMonitor.Views.MainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StatsUsageWidget.Widgets.SystemMonitor.Views"
             Width="{Binding WidgetWidth, FallbackValue=300, TargetNullValue=300}"
             Height="{Binding WidgetHeight, FallbackValue=310, TargetNullValue=310}"
             Background="Transparent">
    <Viewbox Stretch="Uniform">
        <Border Width="300" Height="310"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                Padding="0" Margin="0">
            <Canvas Width="300" Height="310" ClipToBounds="False">
            <local:DialGauge Width="110" Height="110"
                             Canvas.Left="0" Canvas.Top="0"
                             Progress="{Binding MemoryPercent}"
                             Accent="#FF4EA1FF"
                             Label="RAM"
                             ValueText="{Binding MemoryText}" />

            <local:DialGauge Width="110" Height="110"
                             Canvas.Left="190" Canvas.Top="0"
                             Progress="{Binding NetworkDialPercent}"
                             Accent="#FFB28CFF"
                             Label="NETWORK"
                             ValueText="{Binding NetworkText}" />

            <local:DialGauge Width="110" Height="110"
                             Canvas.Left="0" Canvas.Top="200"
                             Progress="{Binding DiskReadDialPercent}"
                             Accent="#FFFFBE55"
                             Label="DISK READ"
                             ValueText="{Binding DiskReadText}" />

            <local:DialGauge Width="110" Height="110"
                             Canvas.Left="190" Canvas.Top="200"
                             Progress="{Binding DiskWriteDialPercent}"
                             Accent="#FFFF7D4D"
                             Label="DISK WRITE"
                             ValueText="{Binding DiskWriteText}" />

            <local:DialGauge Width="150" Height="150"
                             Canvas.Left="75" Canvas.Top="75"
                             Progress="{Binding CpuPercent}"
                             Accent="#FF4FE08B"
                             Label="CPU"
                             ValueText="{Binding CpuText}" />
            </Canvas>
        </Border>
    </Viewbox>
</UserControl>
