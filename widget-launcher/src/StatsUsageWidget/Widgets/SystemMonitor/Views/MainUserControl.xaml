<UserControl x:Class="StatsUsageWidget.Widgets.SystemMonitor.Views.MainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StatsUsageWidget.Widgets.SystemMonitor.Views"
             Width="360" Height="350"
             Background="Transparent">
    <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
            Padding="0" Margin="0">
        <Canvas Width="360" Height="350" ClipToBounds="False">
            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="8" Canvas.Top="4"
                             Progress="{Binding MemoryPercent}"
                             Accent="#FF4EA1FF"
                             Label="RAM"
                             ValueText="{Binding MemoryText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="240" Canvas.Top="4"
                             Progress="{Binding NetworkDialPercent}"
                             Accent="#FFB28CFF"
                             Label="NETWORK"
                             ValueText="{Binding NetworkText}" />

            <local:DialGauge Width="170" Height="170"
                             Canvas.Left="95" Canvas.Top="85"
                             Progress="{Binding CpuPercent}"
                             Accent="#FF4FE08B"
                             Label="CPU"
                             ValueText="{Binding CpuText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="8" Canvas.Top="234"
                             Progress="{Binding DiskReadDialPercent}"
                             Accent="#FFFFBE55"
                             Label="DISK READ"
                             ValueText="{Binding DiskReadText}" />

            <local:DialGauge Width="112" Height="112"
                             Canvas.Left="240" Canvas.Top="234"
                             Progress="{Binding DiskWriteDialPercent}"
                             Accent="#FFFF7D4D"
                             Label="DISK WRITE"
                             ValueText="{Binding DiskWriteText}" />
        </Canvas>
    </Border>
</UserControl>
