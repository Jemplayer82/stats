<UserControl x:Class="StatsUsageWidget.Widgets.Music.Views.AppleMusicUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="430">
    <UserControl.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#D9242730" />
            <Setter Property="BorderBrush" Value="#554B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Border Background="{Binding WidgetBackground}" BorderBrush="#443F3F46" BorderThickness="1"
            CornerRadius="20" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PlaybackStatus}" Foreground="#FFFA2D55"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text=" Music" Foreground="#FFB8B8C0"
                           FontSize="12" FontWeight="SemiBold" />
            </Grid>

            <Button Grid.Row="1" Command="{Binding OpenAppleMusicCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Cursor="Hand" ToolTip="Open Apple Music">
                <Border CornerRadius="14" Background="#FF202028" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="♫" Foreground="#55FFFFFF" FontSize="92"
                                   FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
            </Button>

            <StackPanel Grid.Row="2" Margin="3,12,3,10">
                <TextBlock Text="{Binding SongTitle}" Foreground="White" FontSize="18"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" Foreground="#FFD4D4D8" FontSize="13"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}" Foreground="#FF8E8E98" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⏮" Command="{Binding PreviousCommand}"
                        IsEnabled="{Binding CanControl}" Style="{StaticResource TransportButton}"
                        ToolTip="Previous" />
                <Button Content="{Binding PlayPauseGlyph}" Command="{Binding TogglePlayPauseCommand}"
                        Style="{StaticResource TransportButton}" Width="64"
                        Background="#FFFA2D55" BorderBrush="#FFFA2D55"
                        ToolTip="Play or pause" />
                <Button Content="⏭" Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanControl}" Style="{StaticResource TransportButton}"
                        ToolTip="Next" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
