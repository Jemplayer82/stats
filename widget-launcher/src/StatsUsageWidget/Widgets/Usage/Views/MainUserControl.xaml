<UserControl x:Class="StatsUsageWidget.Widgets.Usage.Views.MainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="QuietText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <Border Width="720" Height="300" BorderBrush="#FF273244" BorderThickness="1"
            CornerRadius="12" Padding="8">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Border.LayoutTransform>
        <Border.Background>
            <SolidColorBrush Color="#FF0B1018" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource QuietText}"
                           TextWrapping="Wrap" Margin="2,0,2,2" />
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF263244" BorderThickness="1"
                                    CornerRadius="8" Padding="6" Margin="2">
                                <Border.Background>
                                    <SolidColorBrush Color="#FF121925"
                                        Opacity="{Binding DataContext.BackgroundOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border.Background>
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Accent}"
                                                     Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Style="{StaticResource QuietText}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,0,4,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#FFD7E0EC"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                                   Foreground="White" FontSize="10"
                                                                   FontWeight="SemiBold" Margin="5,0,0,0" />
                                                    </Grid>
                                                    <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                                 Value="{Binding Percent}" Margin="0,2,0,0"
                                                                 Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                 Background="#FF263244"
                                                                 Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource QuietText}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="1" Margin="2,3,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource QuietText}" />
                <TextBlock Grid.Column="1" Text="Billy · Stats" Style="{StaticResource QuietText}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
