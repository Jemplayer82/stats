<UserControl x:Class="StatsUsageWidget.Widgets.Usage.Views.SettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE2E8F0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Stats Usage Widget" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Connect this widget to the Stats site running on Billy."
                       Foreground="#FF94A3B8" TextWrapping="Wrap" Margin="0,4,0,18" />

            <TextBlock Text="Stats web address" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox Text="{Binding TempStatsBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Padding="9,7" Margin="0,0,0,5" />
            <TextBlock Text="Example: https://stats.txferguson.net"
                       Foreground="#FF94A3B8" FontSize="11" Margin="0,0,0,16" />

            <TextBlock Text="Show these meters" FontWeight="SemiBold" Margin="0,0,0,9" />
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <CheckBox Content="Codex" IsChecked="{Binding TempShowCodex}" />
                <CheckBox Content="Claude" IsChecked="{Binding TempShowClaude}" />
                <CheckBox Content="Ollama" IsChecked="{Binding TempShowOllama}" />
                <CheckBox Content="Gemini" IsChecked="{Binding TempShowGemini}" />
            </UniformGrid>

            <TextBlock Text="Refresh every" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding RefreshOptions}"
                      SelectedItem="{Binding TempRefreshSeconds}"
                      Foreground="#FF111827" Padding="8,6" Margin="0,0,0,16">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} seconds}"
                                   Foreground="#FF111827" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="LLM card transparency" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TempTransparencyPercent, StringFormat={}{0}%}"
                           Foreground="#FF94A3B8" />
            </Grid>
            <Slider Minimum="0" Maximum="90" TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    Value="{Binding TempTransparencyPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,-10,0,16"
                    ToolTip="Higher values make each LLM card background more transparent" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Text and UI size" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TempScalePercent, StringFormat={}{0}%}"
                           Foreground="#FF94A3B8" />
            </Grid>
            <Slider Minimum="75" Maximum="150" TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    Value="{Binding TempScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,-10,0,16"
                    ToolTip="Scale the text, cards, meters, and spacing together" />

            <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                    Padding="12,8" HorizontalAlignment="Left"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0" />
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#FF94A3B8"
                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="Use Widget Launcher's Save button to apply these settings."
                       Foreground="#FF64748B" FontSize="11" TextWrapping="Wrap"
                       Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
